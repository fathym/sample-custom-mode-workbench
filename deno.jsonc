{
  "name": "@fathym/sample-custom-mode-workbench",
  "version": "0.0.0",
  "license": "MIT",
  // The version task resolves a freshly published @fathym/common; skip Deno's 24h dependency-age gate.
  "minimumDependencyAge": "0",
  "exports": {
    ".": "./workbenches/webhook/local.ts"
  },
  "tasks": {
    "webhook": "fai run workbenches/webhook/local.ts --mode Webhook",
    "build": "deno task build:fmt && deno task build:lint && deno task build:check && deno task test",
    "build:check": "deno check **/*.ts",
    "build:fmt": "deno fmt",
    "build:lint": "deno lint",
    "test": "deno test -A tests/",
    "version": "deno run -A jsr:@fathym/common@0.2.325/build/version"
  },
  "imports": {
    "@fathym/fai/tools": "jsr:@fathym/fai@0.0.890-round-10/tools",
    "@fathym/fai/workbenches": "jsr:@fathym/fai@0.0.890-round-10/workbenches",
    "@std/assert": "jsr:@std/assert@1.0.16",
    "zod": "npm:zod@4.1.13"
  },
  "publish": {
    "exclude": ["tests/"]
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "proseWrap": "preserve",
    "semiColons": true,
    "singleQuote": true,
    "useTabs": false
  },
  "lock": false
}
